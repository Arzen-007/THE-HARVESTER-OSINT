# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# Shared app-level gate for scan/history/result procedures; use a random value of 32+ characters.
OSINT_ACCESS_TOKEN=replace_with_a_random_32_plus_character_token
VITE_OSINT_ACCESS_TOKEN=replace_with_the_same_token_for_the_frontend

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
